# Base URL of the TEE service (packages/tee). Must be running the private-route
# quote/create/status + Relay discovery endpoints.
#   local dev:  http://localhost:3000  (pnpm --filter @erebuz/tee dev)
#   hosted:     https://tee.wall8.xyz
NEXT_PUBLIC_TEE_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Test mode: point NEXT_PUBLIC_TEE_URL at a TEE running the Sepolia test hub, and
# set this to "true". Adds Base Sepolia + Sepolia to the wallet chains and defaults
# the picker to a Base Sepolia -> Base Sepolia private route (via the Sepolia hub).
NEXT_PUBLIC_TEST_MODE=false
