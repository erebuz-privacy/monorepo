# Erebuz private-route backend stack. Copy to .env and fill in.
#   cp .env.example .env && docker compose --env-file .env up -d --build
# NEVER commit .env — it holds the signer key, the Railgun wallet, and the
# Mongo/POI credentials.

# ── Mongo (POI datastore, internal only) ─────────────────────────────────────
MONGO_USER=poi
# openssl rand -hex 24
MONGO_PASSWORD=

# ── POI node (Railgun Proof-of-Innocence) ────────────────────────────────────
# Generate the ed25519 pair once:
#   docker compose run --rm --no-deps poi-node node src/config/keyGenerator.js
pkey=
pubkey=
# Recognized list-provider peers to sync from (JSON array). Empty = standalone
# (proves against its own list only). Ask the Railgun builders for live peers.
NODE_CONFIGS=[]
# Networks the POI node syncs (comma-separated). Unset = all POI networks, but
# syncing every mainnet on public RPCs crash-loops the node — pin to what you use.
#   Production: Arbitrum   Testing: Ethereum_Sepolia
ACTIVE_NETWORKS=Arbitrum

# ── TEE (private-route API) ──────────────────────────────────────────────────
# Funded Arbitrum signer EOA (pays gas for shield + unshield). 0x-hex private key.
PRIVATE_KEY=
# Encrypts private-route recipients and Arc Privacy Pool note secrets.
# openssl rand -hex 32
ROUTE_ENCRYPTION_KEY=
# Railgun wallet — generate with `pnpm --filter @erebuz/tee gen:railgun-keys`.
RAILGUN_MNEMONIC=
RAILGUN_ENCRYPTION_KEY=
# Optional Relay API key (higher rate limits); URL defaults to api.relay.link.
RELAY_API_KEY=
RELAY_API_URL=https://api.relay.link
# Your own Arbitrum + mainnet RPC (recommended for reliable syncing).
ETH_MAINNET_RPC_URL=
# RPC for the Railgun hub chain — set the one matching PRIVACY_HUB_CHAIN_ID.
RAILGUN_RPC_42161=
RAILGUN_RPC_11155111=

# ── Hub (defaults are correct: USDC on Arbitrum) ─────────────────────────────
PRIVACY_HUB_CHAIN_ID=42161
PRIVACY_HUB_TOKEN_SYMBOL=USDC
# Existing Railgun routes remain the default; users can choose the Arc pool per route.
DEFAULT_PRIVACY_PROVIDER=railgun
BRIDGE_PROVIDER=relay
# Required only for the alternate Erebuz Privacy Pool route.
ARC_PRIVACY_ASP_URL=
ARC_PRIVACY_ARTIFACTS_URL=

# ── Erebuz Arc ASP automation (testnet only) ─────────────────────────────────
# The default build context expects privacy-pool-arc beside erebuz-monorepo.
ARC_ASP_BUILD_CONTEXT=../../../privacy-pool-arc
ARC_TESTNET_RPC=https://rpc.drpc.testnet.arc.network
ASP_SYNC_CONFIRMATIONS=2
ASP_RELOAD_INTERVAL_MS=5000
ASP_OPERATOR_INTERVAL_MS=15000
ASP_BIND=127.0.0.1
ASP_HOST_PORT=8787
ASP_IPFS_API_URL=https://rpc.filebase.io
ASP_IPFS_BEARER_TOKEN=
ASP_IPFS_GATEWAY_URL=https://ipfs.filebase.io
# Dedicated Arc Testnet ASP_POSTMAN key. Never use a production wallet here.
ASP_POSTMAN_PRIVATE_KEY=

# ── TEST MODE (Sepolia) — validated demo config ──────────────────────────────
# Runs the whole flow on testnet: Base Sepolia USDC -> Sepolia smart-account hub
# -> Railgun -> back to Base Sepolia. Set:
#   RELAY_API_URL=https://api.testnets.relay.link
#   RELAY_VERIFIED_ONLY=false        # testnet tokens are unverified
#   PRIVACY_HUB_CHAIN_ID=11155111
#   PRIVACY_HUB_TOKEN_SYMBOL=USDC
#   PRIVATE_ROUTE_FEE_MIN_USD=0.1    # $1 floor is too high for small testnet amounts
#   ACTIVE_NETWORKS=Ethereum_Sepolia
#   RAILGUN_RPC_11155111=<your sepolia rpc>
# and self-peer the POI node so it validates its own TXID merkletree (required
# before wallets can unshield) — use the node's own listKey (see /node-status-v2):
#   NODE_CONFIGS=[{"name":"self","nodeURL":"http://poi-node:8080","listKey":"<64hex>"}]
# Note: testnet Relay's solver caps leg-2 (Sepolia->Base Sepolia) at ~2 USDC.

# ── Exposure (default: localhost only; put TLS proxies in front) ──────────────
# Set to 0.0.0.0 ONLY with a TLS reverse proxy in front of each.
TEE_BIND=127.0.0.1
TEE_HOST_PORT=3000
POI_BIND=127.0.0.1
POI_HOST_PORT=8080

# Pin the POI node upstream commit (reproducible builds).
POI_REF=4b1eaf6ef19099dbfd6b43b1ca78d2ce0132a752
