# Railgun PPOI list-provider node config. Copy to .env and fill in.
# Generate the ed25519 key pair (run once, paste the output below):
#   docker compose run --rm --no-deps poi-node node src/config/keyGenerator.js

# Run as a list provider (required for a node the wallet can point at).
LIST_PROVIDER=1

# ed25519 keys from keyGenerator (32-byte hex). Keep pkey secret.
pkey=
pubkey=

# MongoDB credentials (required). Use a strong random password, e.g.:
#   openssl rand -hex 24
MONGO_USER=poi
MONGO_PASSWORD=

# Port the node serves the aggregator API on (kept at 8080 inside the container).
POI_HOST_PORT=8080
# Interface to publish on. Default 127.0.0.1 = localhost only (safe). To expose
# publicly, set 0.0.0.0 AND front it with a TLS reverse proxy (see README).
POI_BIND=127.0.0.1

# Peer aggregator / list-provider nodes to sync from, as JSON.
# e.g. [{"name":"Peer","nodeURL":"https://peer.example","listKey":"<64hex>"}]
#
# IMPORTANT for a STANDALONE node: the TXID-merkletree validation (required before
# a wallet can spend/unshield) only runs against peers. With no peers the node
# never produces a `validatedTxidIndex` and unshields stay unspendable. Point the
# node at ITSELF so it validates its own txid merkletree (self-merkleroots always
# match) — use your own pubkey-derived listKey (see /node-status-v2 -> listKeys):
#   NODE_CONFIGS=[{"name":"self","nodeURL":"http://localhost:8080","listKey":"<your-64hex-listKey>"}]
NODE_CONFIGS=[]

# Only load/sync these networks (comma-separated NetworkName values). Unset = all
# POI networks — but syncing every mainnet on public RPCs draws 403s that crash-
# loop the node, so restrict to what you use. Values: Ethereum, BNB_Chain,
# Polygon, Arbitrum, Ethereum_Sepolia.
#   Testing:    ACTIVE_NETWORKS=Ethereum_Sepolia
#   Production: ACTIVE_NETWORKS=Arbitrum   (needs a real Arbitrum RPC, not public)
ACTIVE_NETWORKS=Ethereum_Sepolia

# Pinned upstream commit built by the image (reproducible). Change deliberately.
POI_REF=4b1eaf6ef19099dbfd6b43b1ca78d2ce0132a752

# Optional: OFAC screening via Chainalysis (paid). Leave blank to skip.
# CHAINALYSIS_API_KEY=
# CHAINALYSIS_API_BACKUP_RPC=
